# ============================================================
# TOBURT Studios - Environment Configuration
# ============================================================
# Copy this file to `.env` (in the repo root) and to
# `backend/.env` / `frontend/.env` as needed.

# ---------- Node / runtime ----------
NODE_ENV=development

# ---------- Backend ----------
PORT=8787
BACKEND_BASE_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:5173

# ---------- Supabase ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Optional: legacy HS256 "JWT Secret". Leave blank if your project uses the
# newer JWT Signing Keys — the backend will verify via JWKS automatically.
SUPABASE_JWT_SECRET=

# ---------- Vector / Embeddings ----------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# ---------- LLM Providers ----------
# At least one provider must be set. Agents will pick the best
# available model per agent role (see backend/src/agents/registry.ts).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default models per role
SHOWRUNNER_MODEL=claude-opus-4-7
CONCEPT_MODEL=claude-sonnet-4-6
CHARACTER_MODEL=claude-sonnet-4-6
WORLD_MODEL=claude-sonnet-4-6
PLOT_MODEL=claude-sonnet-4-6
SCENE_MODEL=claude-sonnet-4-6
DIALOGUE_MODEL=claude-sonnet-4-6
SCRIPT_DOCTOR_MODEL=claude-opus-4-7
CONTINUITY_MODEL=claude-haiku-4-5-20251001
PRODUCER_MODEL=claude-sonnet-4-6

# ---------- Frontend (Vite) ----------
# Prefix with VITE_ so they reach the browser bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_BACKEND_URL=http://localhost:8787
VITE_APP_NAME=TOBURT Studios
