# ASH KROW · Design Studio environment variables
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Never commit secrets.

# --- Supabase (saved designs, library, brand settings) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional: Image generation provider (e.g. Replicate, fal.ai, OpenAI, Stability) ---
# The app gracefully falls back to procedurally generated mock artwork when these
# are missing, so you can develop without external services connected.
VITE_IMAGE_API_PROVIDER=mock
VITE_IMAGE_API_URL=
VITE_IMAGE_API_KEY=
VITE_IMAGE_API_MODEL=

# --- Optional: Trend research module ---
# When unset the dashboard uses the curated streetwear/grunge/Y2K trend
# corpus shipped in `src/lib/trendResearch.ts`.
VITE_TREND_API_URL=
VITE_TREND_API_KEY=
